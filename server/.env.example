# ShopSmart Backend — Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=5001

# Database (Supabase PostgreSQL connection string)
# Get this from: Supabase Dashboard > Settings > Database > Connection string (URI)
# Leave empty to use local SQLite for development
DATABASE_URL=

# JWT
JWT_SECRET=your_jwt_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-render-backend.onrender.com/auth/google/callback

# Frontend URL (Vercel deployment URL, used for CORS and OAuth redirects)
FRONTEND_URL=https://your-app.vercel.app

# Backend URL (Render deployment URL)
BACKEND_URL=https://your-render-backend.onrender.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Seed config (optional)
SEED_KAGGLE_LIMIT=1000
